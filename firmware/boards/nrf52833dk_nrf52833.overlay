/ {
    dht11: dht11 {
        compatible = "aosong,dht";
        status = "okay";
        dio-gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
    };
};


   &i2c0 {
       status = "okay";

       bme280: bme280@76 {
           compatible = "bosch,bme280";
           reg = <0x76>;
       };
   };